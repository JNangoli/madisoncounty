    <style>
    
/* =========================================================
   GLOBAL & VARIABLES
========================================================= */

:root {
    --green: #17652f;
    --green-hover: #267a40;
    --dark: #111;
    --white: #fff;
    --gray: #555;
    --light-gray: #f6f8f6;
    --border: #dedede;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background: linear-gradient(135deg, #e9f1ec, #f6f8f6);
    color: var(--dark);
    font-family: "Poppins", sans-serif;
}

body.modal-open {
    overflow: hidden;
}

img {
    display: block;
    width: 100%;
}

button,
input {
    font: inherit;
}

button {
    cursor: pointer;
}

:focus-visible {
    outline: 3px solid var(--green-hover);
    outline-offset: 4px;
    border-radius: 4px;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

/* =========================================================
   SHARED GPU RENDERING
========================================================= */

.department-card,
.department-image img,
.modal-overlay,
.department-modal,
.modal-image,
.modal-image img,
.modal-content,
.close-modal {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
}

/* =========================================================
   GALLERY
========================================================= */

.gallery-section {
    background: var(--white);
    padding: 100px 0 120px;
}

.gallery-container {
    width: min(1080px, 90%);
    margin: auto;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.gallery-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

/* =========================================================
   DEPARTMENT CARDS
========================================================= */

.department-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 5px;
    overflow: hidden;
    cursor: pointer;
    transform: translate3d(0, 0, 0);

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.department-card:hover {
    transform: translate3d(0, -6px, 0);
    box-shadow: 0 15px 35px rgba(0, 0, 0, .1);
    border-color: transparent;
}

/* =========================================================
   DEPARTMENT IMAGES
========================================================= */

.department-image {
    overflow: hidden;
}

.department-image img {
    transition: transform .4s ease;
}

.department-card:hover .department-image img {
    transform: translate3d(0, 0, 0) scale(1.05);
}

/* =========================================================
   DEPARTMENT CONTENT
========================================================= */

.department-content {
    padding: 17px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.department-title {
    font-size: 1.05rem;
    font-weight: 700;
}

.department-description {
    color: #666;
    font-size: .78rem;
    margin-top: 3px;
}

.department-category {
    color: var(--green);
    text-transform: uppercase;
    font-size: .65rem;
    letter-spacing: .08rem;
    margin-top: 7px;
    font-weight: 700;
}

/* =========================================================
   MODAL OVERLAY
========================================================= */

.modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px;

  background: rgba(255, 255, 255, .85);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    opacity: 0;
    visibility: hidden;

    transform: translate3d(0, 0, 0);
    will-change: opacity;

    transition:
        opacity .3s ease,
        visibility .3s ease;
}

.modal-overlay.open {
    opacity: 1;
    visibility: visible;
}

/* =========================================================
   MODAL CONTAINER
========================================================= */

.department-modal {
    width: min(900px, 100%);
    height: min(760px, 90vh);

    display: grid;
    grid-template-columns: 42% 58%;

    background: var(--white);
    overflow: hidden;
    border-radius: 8px;

    box-shadow: 0 30px 80px rgba(0, 0, 0, .3);

    transform: translate3d(0, 35px, 0) scale(.95);
    opacity: 0;
    will-change: transform, opacity;

    transition:
        transform .4s cubic-bezier(.2, .8, .2, 1),
        opacity .3s ease;
}

.modal-overlay.open .department-modal {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
}

/* =========================================================
   MODAL IMAGE - STATIC COLUMN
========================================================= */

.modal-image {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    transform: translate3d(0, 0, 0);
}

.modal-image img {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    transform: translate3d(0, 0, 0);
}

.modal-image-overlay {
    position: absolute;
    inset: auto 0 0;

    padding: 35px 28px 28px;

    color: var(--white);

    background: linear-gradient(
        transparent,
        rgba(252, 251, 251, 0.78)
    );

    z-index: 2;
}

.modal-image-overlay span {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .12rem;
    opacity: .95;
}

.modal-image-overlay h3 {
    font-family: "Comfortaa", cursive;
    font-size: 1.8rem;
    margin-top: 5px;
}

/* =========================================================
   MODAL CONTENT - SCROLLABLE COLUMN
========================================================= */

.modal-content {
    position: relative;

    min-height: 0;
    height: 100%;

    padding: 45px;

    overflow-y: auto;
    overflow-x: hidden;

    scroll-behavior: smooth;
    overscroll-behavior: contain;

    -webkit-overflow-scrolling: touch;

    transform: translate3d(0, 0, 0);
}

/* MODAL SCROLLBAR */

.modal-content::-webkit-scrollbar {
    width: 8px;
}

.modal-content::-webkit-scrollbar-track {
    background: #f4f5f4;
}

.modal-content::-webkit-scrollbar-thumb {
    background: #c8ccc9;
    border-radius: 20px;
}

.modal-content::-webkit-scrollbar-thumb:hover {
    background: #aeb4af;
}

/* =========================================================
   CLOSE BUTTON
========================================================= */

.close-modal {
    position: absolute;
    top: 20px;
    right: 20px;

    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #ccc;
    background: var(--white);
    border-radius: 50%;

    color: #444;
    transform: translate3d(0, 0, 0);

    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease,
        transform .25s ease;
}

.close-modal:hover {
    background: var(--dark);
    color: var(--white);
    border-color: var(--dark);
    transform: translate3d(0, 0, 0) rotate(90deg);
}

/* =========================================================
   MODAL TYPOGRAPHY
========================================================= */

.modal-eyebrow {
    color: var(--green);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .13rem;
    font-weight: 700;
}

.modal-content h2 {
    font-family: "Comfortaa", cursive;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin: 10px 0 18px;
    padding-right: 40px;
}

.modal-description {
    color: var(--gray);
    line-height: 1.75;
    font-size: .9rem;
}

.modal-divider {
    height: 1px;
    background: #e5e5e5;
    margin: 28px 0;
}

/* =========================================================
   MODAL DETAILS
========================================================= */

.modal-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.detail-box {
    background: var(--light-gray);
    padding: 18px;
    border-radius: 5px;
}

.detail-box span {
    display: block;
    color: #777;
    text-transform: uppercase;
    font-size: .62rem;
    letter-spacing: .08rem;
    margin-bottom: 6px;
}

.detail-box strong {
    font-size: .85rem;
    font-weight: 600;
}

/* =========================================================
   MODAL SERVICES
========================================================= */

.modal-section {
    margin-top: 30px;
}

.modal-section h4 {
    font-size: .82rem;
    text-transform: uppercase;
    letter-spacing: .08rem;
    margin-bottom: 12px;
}

.service-list {
    list-style: none;
}

.service-list li {
    display: flex;
    align-items: center;
    gap: 10px;

    color: var(--gray);
    font-size: .82rem;
    padding: 7px 0;
}

/* =========================================================
   MODAL ACTIONS
========================================================= */

.modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 30px;
}

.modal-primary,
.modal-secondary {
    padding: 12px 20px;
    border-radius: 50px;
    font-size: .8rem;
    font-weight: 600;
    transition: .2s ease;
}

.modal-primary {
    background: var(--dark);
    color: var(--white);
}

.modal-primary:hover {
    background: var(--green);
}

.modal-secondary {
    border: 1px solid #ccc;
    background: var(--white);
    color: #333;
}

.modal-secondary:hover {
    border-color: var(--dark);
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

    .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .department-modal {
        height: min(700px, 90vh);
        grid-template-columns: 1fr 1fr;
    }

}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .gallery-section {
        padding: 70px 0 80px;
    }

    .gallery-grid {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .gallery-column {
        gap: 18px;
    }

    /* MOBILE MODAL */

    .modal-overlay {
        padding: 12px;
        align-items: flex-end;
    }

    .department-modal {
        width: 100%;
        max-height: 94vh;
        height: auto;

        display: flex;
        flex-direction: column;

        border-radius: 18px 18px 10px 10px;

        transform: translate3d(0, 60px, 0) scale(.98);
    }

    .modal-overlay.open .department-modal {
        transform: translate3d(0, 0, 0) scale(1);
    }

    .modal-image {
        position: relative;
        min-height: 220px;
        height: 220px;
        flex-shrink: 0;
        overflow: hidden;
    }

    .modal-image img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .modal-image-overlay {
        padding: 45px 20px 18px;
    }

    .modal-image-overlay h3 {
        font-size: 1.4rem;
    }

    .modal-content {
        height: auto;
        min-height: 0;

        padding: 30px 22px 25px;

        overflow-y: auto;
        overflow-x: hidden;

        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        scroll-behavior: smooth;
    }

    .close-modal {
        z-index: 5;
        top: 14px;
        right: 14px;
        background: rgba(255, 255, 255, .95);
    }

    .modal-content h2 {
        font-size: 2rem;
    }

    .modal-details {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .detail-box {
        padding: 14px;
    }

    .modal-actions {
        flex-direction: column;
    }

    .modal-primary,
    .modal-secondary {
        display: block;
        text-align: center;
        width: 100%;
    }

}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }

    .department-modal {
        transform: none !important;
    }

    .modal-overlay {
        transition: none !important;
    }

}

    </style>
</head>

<body>



    <div id="root"></div>

    <script type="text/babel">

        const {
            useState,
            useEffect,
            useRef
        } = React;


        /* =========================================================
           DATA
        ========================================================= */

        const departments = [
            {
                name: "Public Works",
                category: "Infrastructure",
                description: "Roads, bridges & infrastructure",
                fullDescription:
                    "The Public Works Department manages the county's roads, bridges, drainage systems, facilities and other essential infrastructure.",
                phone: "(555) 210-4100",
                email: "publicworks@county.gov",
                location: "County Administration Center",
                hours: "Mon–Fri · 8:00 AM–4:30 PM",
                services: [
                    "Road maintenance",
                    "Bridge maintenance",
                    "Snow & ice removal",
                    "Drainage and stormwater",
                    "County facility maintenance"
                ],
                image:
                    "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1000&q=85"
            },


        ];

        function DepartmentCard({
            department,
            onOpen
        }) {

            return (
                <article
                    className="department-card"
                    onClick={() => onOpen(department)}
                    tabIndex="0"
                    role="button"
                    aria-label={
                        `View details for ${department.name}`
                    }
                    onKeyDown={(event) => {

                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {

                            event.preventDefault();

                            onOpen(department);

                        }

                    }}
                >

                    <div className="department-image">

                        <img
                            src={department.image}
                            alt=""
                            loading="lazy"
                            aria-hidden="true"
                        />

                    </div>

                    <div className="department-content">

                        <div>

                            <h3 className="department-title">
                                {department.name}
                            </h3>

                            <p className="department-description">
                                {department.description}
                            </p>

                            <div className="department-category">
                                {department.category}
                            </div>

                        </div>

                    </div>

                </article>
            );
        }


        /* =========================================================
           ACCESSIBLE MODAL
        ========================================================= */


function DepartmentModal({ department, onClose }) {
    const modalRef = useRef(null);
    const closeButtonRef = useRef(null);
    const previousFocusedElement = useRef(null);

    useEffect(() => {
        if (!department) return;

        previousFocusedElement.current = document.activeElement;
        document.body.classList.add("modal-open");

        setTimeout(() => closeButtonRef.current?.focus(), 50);

        function handleKeyDown(event) {
            if (event.key === "Escape") {
                event.preventDefault();
                onClose();
                return;
            }

            if (event.key !== "Tab") return;

            const focusable = modalRef.current?.querySelectorAll(
                'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
            );

            if (!focusable?.length) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        }

        document.addEventListener("keydown", handleKeyDown);

        return () => {
            document.body.classList.remove("modal-open");
            document.removeEventListener("keydown", handleKeyDown);
            previousFocusedElement.current?.focus?.();
        };
    }, [department, onClose]);

    if (!department) return null;

    const details = [
        ["Phone", department.phone],
        ["Email", department.email],
        ["Location", department.location],
        ["Hours", department.hours]
    ];

    return (
        <div
            className="modal-overlay open"
            onMouseDown={e => {
                if (e.target === e.currentTarget) onClose();
            }}
            aria-hidden={!department}
        >
            <div
                ref={modalRef}
                className="department-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="department-modal-title"
                aria-describedby="department-modal-description"
            >
                <div className="modal-image">
                    <img src={department.image} alt="" aria-hidden="true" />

                    <div className="modal-image-overlay">
                        <span>{department.category}</span>
                        <h3>{department.name}</h3>
                    </div>
                </div>

                <div className="modal-content">
                    <button
                        ref={closeButtonRef}
                        className="close-modal"
                        onClick={onClose}
                        aria-label={`Close ${department.name} details`}
                    >
                        f
                    </button>

                    <span className="modal-eyebrow">
                        County Department
                    </span>

                    <h2 id="department-modal-title">
                        {department.name}
                    </h2>

                    <p
                        id="department-modal-description"
                        className="modal-description"
                    >
                        {department.fullDescription}
                    </p>

                    <div className="modal-divider" />

                    <div
                        className="modal-details"
                        aria-label="Department contact information"
                    >
                        {details.map(([label, value]) => (
                            <div className="detail-box" key={label}>
                                <span>{label}</span>
                                <strong>{value}</strong>
                            </div>
                        ))}
                    </div>

                    <div className="modal-section">
                        <h4>Services</h4>

                        <ul className="service-list">
                            {department.services.map((service, index) => (
                                <li key={index}>
                                    g
                                    <span>{service}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div className="modal-actions">
                        <a
                            href={`tel:${department.phone}`}
                            className="modal-primary"
                            aria-label={`Call ${department.name}`}
                        >
                            Phone
                            <span>Call Department</span>
                        </a>

                        <a
                            href={`mailto:${department.email}`}
                            className="modal-secondary"
                            aria-label={`Email ${department.name}`}
                        >
                            MailIcon
                            <span>Send Email</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    );
}



        /* =========================================================
           GALLERY
        ========================================================= */

        
function DepartmentGallery({ onOpenDepartment }) {
    return (
        <section
            className="gallery-section"
            id="departments"
            aria-label="County departments"
        >
            <div className="gallery-container">
                <div className="gallery-grid">

                    {Array.from({ length: 3 }, (_, column) => (
                        <div className="gallery-column" key={column}>
                            {departments
                                .filter((_, index) => index % 3 === column)
                                .map(department => (
                                    <DepartmentCard
                                        key={department.name}
                                        department={department}
                                        onOpen={onOpenDepartment}
                                    />
                                ))}
                        </div>
                    ))}

                </div>
            </div>
        </section>
    );
}

/* APP */

function App() {
    const [selectedDepartment, setSelectedDepartment] = useState(null);

    return (
        <>
            <DepartmentGallery
                onOpenDepartment={setSelectedDepartment}
            />

            <DepartmentModal
                department={selectedDepartment}
                onClose={() => setSelectedDepartment(null)}
            />
        </>
    );
}
        ReactDOM
            .createRoot(
                document.getElementById("root")
            )
            .render(<App />);

    </script>

</body>

</html>
