  padding: "8px 10px",
  border: "1px solid #94a3b8",
  borderRadius: "6px",
  color: "#0f172a",
  background: "#ffffff",
  fontSize: "1rem",
};

const NumberField = ({
  label,
  value,
  min = -2000,
  max = 4000,
  onChange,
}) => {
  return (
    <Field label={label}>
      <input
        type="number"
        min={min}
        max={max}
        value={Number.isFinite(Number(value)) ? Number(value) : 0}
        onChange={(event) => onChange(Number(event.target.value))}
        style={inputStyle}
      />
    </Field>
  );
};

const ColorField = ({ label, value, onChange }) => {
  const validColor =
    typeof value === "string" && value.startsWith("#")
      ? value
      : "#000000";

  return (
    <Field label={label}>
      <input
        type="color"
        value={validColor}
        onChange={(event) => onChange(event.target.value)}
        style={{
          ...inputStyle,
          padding: "4px",
          cursor: "pointer",
        }}
      />
    </Field>
  );
};

const LayerEditor = () => {
  const {
    currentTemplate,
    selectedLayerId,
    setSelectedLayerId,
    updateCurrentLayer,
  } = useContext(MainContext);

  const selectedLayer = currentTemplate.Layers.find(
    (layer) => layer.id === selectedLayerId
  );

  if (!selectedLayer) {
    return (
      <section
        style={{
          padding: "20px",
          border: "1px solid #cbd5e1",
          borderRadius: "12px",
          background: "#ffffff",
        }}
      >
        <h2 style={{ margin: "0 0 8px" }}>Layer editor</h2>

        <p style={{ margin: 0, color: "#475569", lineHeight: 1.5 }}>
          Select the active template, then click text, a border, an icon,
          a line, a circle, or another visible SVG layer to edit it.
        </p>
      </section>
    );
  }

  const update = (updates) => updateCurrentLayer(selectedLayer.id, updates);

  return (
    <section
      aria-labelledby="layer-editor-title"
      style={{
        padding: "20px",
        border: "1px solid #cbd5e1",
        borderRadius: "12px",
        background: "#ffffff",
      }}
    >
      <div
        style={{
          display: "flex",
          alignItems: "flex-start",
          justifyContent: "space-between",
          gap: "12px",
          marginBottom: "18px",
        }}
      >
        <div>
          <h2 id="layer-editor-title" style={{ margin: 0 }}>
            Layer editor
          </h2>

          <p
            style={{
              margin: "5px 0 0",
              color: "#475569",
              textTransform: "capitalize",
            }}
          >
            Editing {selectedLayer.layer}
          </p>
        </div>

        <button
          type="button"
          onClick={() => setSelectedLayerId(null)}
          style={{
            cursor: "pointer",
            padding: "7px 10px",
            border: "1px solid #94a3b8",
            borderRadius: "6px",
            color: "#0f172a",
            background: "#ffffff",
          }}
        >
          Close
        </button>
      </div>

      {selectedLayer.locked && (
        <p
          style={{
            padding: "10px 12px",
            margin: "0 0 16px",
            borderRadius: "6px",
            color: "#854d0e",
            background: "#fef3c7",
            fontSize: "0.875rem",
            lineHeight: 1.4,
          }}
        >
          This is a locked background layer. It is visible but cannot be
          dragged or edited.
        </p>
      )}

      {!selectedLayer.locked && (
        <>
          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
              gap: "12px",
            }}
          >
            {selectedLayer.layer === "text" && (
              <>
                <Field label="Text content">
                  <input
                    type="text"
                    value={selectedLayer.content || ""}
                    onChange={(event) => update({ content: event.target.value })}
                    style={inputStyle}
                  />
                </Field>

                <ColorField
                  label="Text color"
                  value={selectedLayer.fill}
                  onChange={(fill) => update({ fill })}
                />

                <NumberField
                  label="X position"
                  value={selectedLayer.x}
                  onChange={(x) => update({ x })}
                />

                <NumberField
                  label="Y position"
                  value={selectedLayer.y}
                  onChange={(y) => update({ y })}
                />

                <NumberField
                  label="Font size"
                  value={selectedLayer.fontSize}
                  min={8}
                  max={300}
                  onChange={(fontSize) => update({ fontSize })}
                />
              </>
            )}

            {selectedLayer.layer === "rect" && (
              <>
                <NumberField
                  label="X position"
                  value={selectedLayer.x}
                  onChange={(x) => update({ x })}
                />

                <NumberField
                  label="Y position"
                  value={selectedLayer.y}
                  onChange={(y) => update({ y })}
                />

                <NumberField
                  label="Width"
                  value={selectedLayer.width}
                  min={1}
                  onChange={(width) => update({ width })}
                />

                <NumberField
                  label="Height"
                  value={selectedLayer.height}
                  min={1}
                  onChange={(height) => update({ height })}
                />

                <NumberField
                  label="Corner radius X"
                  value={selectedLayer.rx}
                  min={0}
                  onChange={(rx) => update({ rx })}
                />

                <NumberField
                  label="Corner radius Y"
                  value={selectedLayer.ry}
                  min={0}
                  onChange={(ry) => update({ ry })}
                />

                <ColorField
                  label="Fill color"
                  value={selectedLayer.fill}
                  onChange={(fill) => update({ fill })}
                />

                <ColorField
                  label="Border color"
                  value={selectedLayer.stroke}
                  onChange={(stroke) => update({ stroke })}
                />

                <NumberField
                  label="Border width"
                  value={selectedLayer.strokeWidth}
                  min={0}
                  max={100}
                  onChange={(strokeWidth) => update({ strokeWidth })}
                />
              </>
            )}

            {selectedLayer.layer === "circle" && (
              <>
                <NumberField
                  label="Center X"
                  value={selectedLayer.x}
                  onChange={(x) => update({ x })}
                />

                <NumberField
                  label="Center Y"
                  value={selectedLayer.y}
                  onChange={(y) => update({ y })}
                />

                <NumberField
                  label="Radius"
                  value={selectedLayer.radius}
                  min={1}
                  max={1000}
                  onChange={(radius) => update({ radius })}
                />

                <ColorField
                  label="Fill color"
                  value={selectedLayer.fill}
                  onChange={(fill) => update({ fill })}
                />

                <ColorField
                  label="Border color"
                  value={selectedLayer.stroke}
                  onChange={(stroke) => update({ stroke })}
                />

                <NumberField
                  label="Border width"
                  value={selectedLayer.strokeWidth}
                  min={0}
                  max={100}
                  onChange={(strokeWidth) => update({ strokeWidth })}
                />
              </>
            )}

            {selectedLayer.layer === "line" && (
              <>
                <NumberField
                  label="Start X"
                  value={selectedLayer.x1}
                  onChange={(x1) => update({ x1 })}
                />

                <NumberField
                  label="Start Y"
                  value={selectedLayer.y1}
                  onChange={(y1) => update({ y1 })}
                />

                <NumberField
                  label="End X"
                  value={selectedLayer.x2}
                  onChange={(x2) => update({ x2 })}
                />

                <NumberField
                  label="End Y"
                  value={selectedLayer.y2}
                  onChange={(y2) => update({ y2 })}
                />

                <ColorField
                  label="Line color"
                  value={selectedLayer.stroke}
                  onChange={(stroke) => update({ stroke })}
                />

                <NumberField
                  label="Line width"
                  value={selectedLayer.strokeWidth}
                  min={1}
                  max={100}
                  onChange={(strokeWidth) => update({ strokeWidth })}
                />
              </>
            )}

            {selectedLayer.layer === "polyline" && (
              <>
                <Field label="Points">
                  <input
                    type="text"
                    value={selectedLayer.points || ""}
                    onChange={(event) => update({ points: event.target.value })}
                    style={inputStyle}
                  />
                </Field>

                <ColorField
                  label="Fill color"
                  value={selectedLayer.fill}
                  onChange={(fill) => update({ fill })}
                />

                <ColorField
                  label="Line color"
                  value={selectedLayer.stroke}
                  onChange={(stroke) => update({ stroke })}
                />

                <NumberField
                  label="Line width"
                  value={selectedLayer.strokeWidth}
                  min={1}
                  max={100}
                  onChange={(strokeWidth) => update({ strokeWidth })}
                />
              </>
            )}
          </div>

          <button
            type="button"
            onClick={() => {
              update({ display: "none" });
              setSelectedLayerId(null);
            }}
            style={{
              cursor: "pointer",
              width: "100%",
              marginTop: "18px",
              padding: "10px 14px",
              border: "1px solid #b91c1c",
              borderRadius: "6px",
              color: "#b91c1c",
              background: "#ffffff",
              fontWeight: 700,
            }}
          >
            Hide selected layer
          </button>
        </>
      )}
    </section>
  );
};

const Main = () => {
  const {
    templates,
    currentTemplate,
    currentTemplateId,
    selectTemplate,
    setSelectedLayerId,
  } = useContext(MainContext);

  return (
    <main
      onKeyDown={(event) => {
        if (event.key === "Escape") {
          setSelectedLayerId(null);
        }
      }}
      style={{
        minHeight: "100vh",
        padding: "32px",
        background: "#f1f5f9",
        color: "#0f172a",
        fontFamily: "Arial, sans-serif",
      }}
    >
      <section
        aria-labelledby="page-title"
        style={{
          width: "100%",
          maxWidth: "1240px",
          margin: "0 auto",
        }}
      >
        <h1
          id="page-title"
          style={{
            margin: "0 0 8px",
            fontSize: "2rem",
          }}
        >
          SVG Template Builder
        </h1>

        <p
          style={{
            margin: "0 0 24px",
            color: "#475569",
            lineHeight: 1.5,
          }}
        >
          The active template is <strong>{currentTemplate.name}</strong>.
          Click a visible layer in the main design to select it, drag it to
          reposition it, or edit its properties in the panel.
        </p>

        <div
          style={{
            display: "grid",
            gridTemplateColumns: "minmax(0, 2fr) minmax(320px, 1fr)",
            gap: "24px",
            alignItems: "start",
          }}
        >
          <section aria-label={`${currentTemplate.name} editable canvas`}>
            <ActiveSvgCanvas />
          </section>

          <LayerEditor />
        </div>
      </section>

      <aside
        aria-labelledby="template-designs-title"
        style={{
          width: "100%",
          maxWidth: "1240px",
          margin: "32px auto 0",
        }}
      >
        <div
          style={{
            display: "flex",
            alignItems: "baseline",
            justifyContent: "space-between",
            gap: "16px",
            marginBottom: "14px",
          }}
        >
          <div>
            <h2
              id="template-designs-title"
              style={{
                margin: 0,
                fontSize: "1.35rem",
              }}
            >
              Template designs
            </h2>

            <p
              style={{
                margin: "6px 0 0",
                color: "#475569",
              }}
            >
              Choose a card to make it active in the editor.
            </p>
          </div>

          <span
            aria-live="polite"
            style={{
              color: "#475569",
              fontSize: "0.875rem",
            }}
          >
            Active: {currentTemplate.name}
          </span>
        </div>

        <ul
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(240px, 1fr))",
            gap: "18px",
            padding: 0,
            margin: 0,
            listStyle: "none",
          }}
        >
          {templates.map((template) => (
            <TemplateCard
              key={template.id}
              template={template}
              isActive={template.id === currentTemplateId}
              onSelect={selectTemplate}
            />
          ))}
        </ul>
      </aside>
    </main>
  );
};

ReactDOM.createRoot(document.getElementById("root")).render(
  <React.StrictMode>
    <Provider>
      <Main />
    </Provider>
  </React.StrictMode>
);
