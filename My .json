const Provider = ({ children }) => {
  const [templates, setTemplates] = useState(initialTemplates);
  const [currentTemplateId, setCurrentTemplateId] = useState(
    initialTemplates[0].id
  );
  const [selectedLayerId, setSelectedLayerId] = useState(null);

  const currentTemplate = useMemo(() => {
    return templates.find((template) => template.id === currentTemplateId);
  }, [templates, currentTemplateId]);

  const selectTemplate = (templateId) => {
    setCurrentTemplateId(templateId);
    setSelectedLayerId(null);
  };

  const updateCurrentLayer = (layerId, updates) => {
    setTemplates((previousTemplates) =>
      previousTemplates.map((template) => {
        if (template.id !== currentTemplateId) {
          return template;
        }

        return {
          ...template,
          Layers: template.Layers.map((layer) =>
            layer.id === layerId ? { ...layer, ...updates } : layer
          ),
        };
      })
    );
  };

  return (
    <MainContext.Provider
      value={{
        templates,
        currentTemplate,
        currentTemplateId,
        selectedLayerId,
        setSelectedLayerId,
        selectTemplate,
        updateCurrentLayer,
      }}
    >
      {children}
    </MainContext.Provider>
  );
};

const getSvgPoint = (svgElement, clientX, clientY) => {
  const point = svgElement.createSVGPoint();

  point.x = clientX;
  point.y = clientY;

  const matrix = svgElement.getScreenCTM();

  if (!matrix) {
    return { x: 0, y: 0 };
  }

  return point.matrixTransform(matrix.inverse());
};

const getLayerBounds = (layer) => {
  if (layer.layer === "text") {
    const fontSize = Number(layer.fontSize) || 32;
    const contentLength = Math.max(1, String(layer.content || "").length);
    const width = Math.max(80, contentLength * fontSize * 0.62);

    let x = Number(layer.x) || 0;

    if (layer.textAnchor === "middle") {
      x -= width / 2;
    }

    if (layer.textAnchor === "end") {
      x -= width;
    }

    return {
      x,
      y: (Number(layer.y) || 0) - fontSize,
      width,
      height: fontSize + 16,
    };
  }

  if (layer.layer === "rect") {
    return {
      x: Number(layer.x) || 0,
      y: Number(layer.y) || 0,
      width: Number(layer.width) || 0,
      height: Number(layer.height) || 0,
    };
  }

  if (layer.layer === "circle") {
    const radius = Number(layer.radius) || 0;

    return {
      x: (Number(layer.x) || 0) - radius,
      y: (Number(layer.y) || 0) - radius,
      width: radius * 2,
      height: radius * 2,
    };
  }

  if (layer.layer === "line") {
    const x1 = Number(layer.x1) || 0;
    const y1 = Number(layer.y1) || 0;
    const x2 = Number(layer.x2) || 0;
    const y2 = Number(layer.y2) || 0;
    const padding = Math.max(10, Number(layer.strokeWidth) || 2);

    return {
      x: Math.min(x1, x2) - padding,
      y: Math.min(y1, y2) - padding,
      width: Math.abs(x2 - x1) + padding * 2,
      height: Math.abs(y2 - y1) + padding * 2,
    };
  }

  if (layer.layer === "polyline") {
    const points = String(layer.points || "")
      .trim()
      .split(/\s+/)
      .map((point) => point.split(",").map(Number))
      .filter(([x, y]) => Number.isFinite(x) && Number.isFinite(y));

    if (!points.length) {
      return { x: 0, y: 0, width: 0, height: 0 };
    }

    const xValues = points.map(([x]) => x);
    const yValues = points.map(([, y]) => y);
    const padding = Math.max(10, Number(layer.strokeWidth) || 2);

    return {
      x: Math.min(...xValues) - padding,
      y: Math.min(...yValues) - padding,
      width: Math.max(...xValues) - Math.min(...xValues) + padding * 2,
      height: Math.max(...yValues) - Math.min(...yValues) + padding * 2,
    };
  }

  return { x: 0, y: 0, width: 0, height: 0 };
};

const moveLayer = (layer, deltaX, deltaY) => {
  if (layer.layer === "text" || layer.layer === "rect" || layer.layer === "circle") {
    return {
      x: Math.round((Number(layer.x) || 0) + deltaX),
      y: Math.round((Number(layer.y) || 0) + deltaY),
    };
  }

  if (layer.layer === "line") {
    return {
      x1: Math.round((Number(layer.x1) || 0) + deltaX),
      y1: Math.round((Number(layer.y1) || 0) + deltaY),
      x2: Math.round((Number(layer.x2) || 0) + deltaX),
      y2: Math.round((Number(layer.y2) || 0) + deltaY),
    };
  }

  if (layer.layer === "polyline") {
    const points = String(layer.points || "")
      .trim()
      .split(/\s+/)
      .map((point) => {
        const [x, y] = point.split(",").map(Number);

        return `${Math.round(x + deltaX)},${Math.round(y + deltaY)}`;
      })
      .join(" ");

    return { points };
  }

  return {};
};

const SvgDefs = ({ prefix }) => {
  return (
    <defs>
      <linearGradient
        id={`${prefix}-publicNoticeBackground`}
        x1="0%"
        y1="0%"
        x2="100%"
        y2="100%"
      >
        <stop offset="0%" stopColor="#1e3a8a" />
        <stop offset="55%" stopColor="#2563eb" />
        <stop offset="100%" stopColor="#0f766e" />
      </linearGradient>

      <linearGradient
        id={`${prefix}-boardMeetingBackground`}
        x1="0%"
        y1="0%"
        x2="100%"
        y2="100%"
      >
        <stop offset="0%" stopColor="#78350f" />
        <stop offset="45%" stopColor="#b45309" />
        <stop offset="100%" stopColor="#1f2937" />
      </linearGradient>

      <linearGradient
        id={`${prefix}-communityEventBackground`}
        x1="0%"
        y1="0%"
        x2="100%"
        y2="100%"
      >
        <stop offset="0%" stopColor="#6b21a8" />
        <stop offset="52%" stopColor="#c026d3" />
        <stop offset="100%" stopColor="#db2777" />
      </linearGradient>
    </defs>
  );
};

const getSafeFill = (fill, prefix) => {
  if (fill === "url(#publicNoticeBackground)") {
    return `url(#${prefix}-publicNoticeBackground)`;
  }

  if (fill === "url(#boardMeetingBackground)") {
    return `url(#${prefix}-boardMeetingBackground)`;
  }

  if (fill === "url(#communityEventBackground)") {
    return `url(#${prefix}-communityEventBackground)`;
  }

  return fill;
};

const SelectionOutline = ({ layer }) => {
  const bounds = getLayerBounds(layer);

  return (
    <rect
      x={bounds.x - 8}
      y={bounds.y - 8}
      width={bounds.width + 16}
      height={bounds.height + 16}
      fill="transparent"
      stroke="#38bdf8"
      strokeWidth="3"
      strokeDasharray="8 5"
      pointerEvents="none"
    />
  );
};

const SvgLayer = ({
  layer,
  gradientPrefix,
  editable = false,
  isSelected = false,
  onSelect,
  onDragStart,
}) => {
  if (layer.display === "none") {
    return null;
  }

  const isLocked = layer.locked === true;
  const safeFill = getSafeFill(layer.fill, gradientPrefix);

  const interactionProps =
    editable && !isLocked
      ? {
          onPointerDown: (event) => {
            event.stopPropagation();
            onSelect(layer.id);
            onDragStart(event, layer);
          },
          style: {
            cursor: "move",
          },
        }
      : {};

  const commonProps = {
    fill: safeFill ?? "none",
    stroke: layer.stroke ?? "none",
    strokeWidth: layer.strokeWidth,
    strokeOpacity: layer.strokeOpacity,
    fillOpacity: layer.fillOpacity,
    opacity: layer.opacity,
    strokeLinecap: layer.strokelinecap,
    strokeLinejoin: layer.strokeLinejoin,
    display: layer.display || undefined,
    pointerEvents: editable && !isLocked ? "all" : "none",
    ...interactionProps,
  };

  return (
    <g>
      {layer.layer === "rect" && (
        <rect
          x={layer.x}
          y={layer.y}
          width={layer.width}
          height={layer.height}
          rx={layer.rx}
          ry={layer.ry}
          {...commonProps}
        />
      )}

      {layer.layer === "circle" && (
        <circle
          cx={layer.x}
          cy={layer.y}
          r={layer.radius}
          {...commonProps}
        />
      )}

      {layer.layer === "line" && (
        <line
          x1={layer.x1}
          y1={layer.y1}
          x2={layer.x2}
          y2={layer.y2}
          {...commonProps}
        />
      )}

      {layer.layer === "polyline" && (
        <polyline points={layer.points} {...commonProps} />
      )}

      {layer.layer === "text" && (
        <text
          x={layer.x}
          y={layer.y}
          fill={safeFill || "#000000"}
          fontFamily={layer.fontFamily}
          fontSize={layer.fontSize}
          fontWeight={layer.fontWeight}
          fontStyle={layer.fontStyle}
          dominantBaseline={layer.dominantBaseline}
          textAnchor={layer.textAnchor}
          fillOpacity={layer.fillOpacity}
          opacity={layer.opacity}
          display={layer.display || undefined}
          pointerEvents={editable && !isLocked ? "all" : "none"}
          {...interactionProps}
        >
          {layer.content}
        </text>
      )}

      {editable && isSelected && <SelectionOutline layer={layer} />}
    </g>
  );
};

const TemplateThumbnail = ({ template }) => {
  const prefix = `thumbnail-${template.id}`;

  return (
    <svg
      viewBox={`0 0 ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
      width="100%"
      role="img"
      aria-label={`${template.name} template preview`}
      preserveAspectRatio="xMidYMid meet"
      style={{
        display: "block",
        width: "100%",
        aspectRatio: "3 / 2",
        borderRadius: "8px",
        overflow: "hidden",
        background: "#ffffff",
      }}
    >
      <SvgDefs prefix={prefix} />

      {template.Layers.map((layer) => (
        <SvgLayer
          key={layer.id}
          layer={layer}
          gradientPrefix={prefix}
          editable={false}
        />
      ))}
    </svg>
  );
};

const TemplateCard = ({ template, isActive, onSelect }) => {
  return (
    <li style={{ minWidth: 0 }}>
      <button
        type="button"
        onClick={() => onSelect(template.id)}
        aria-pressed={isActive}
        aria-label={`Select ${template.name} template`}
        style={{
          cursor: "pointer",
          display: "block",
          width: "100%",
          padding: "10px",
          border: isActive ? "3px solid #2563eb" : "1px solid #cbd5e1",
          borderRadius: "12px",
          background: "#ffffff",
          textAlign: "left",
          color: "#0f172a",
          boxShadow: isActive
            ? "0 0 0 4px rgba(37, 99, 235, 0.18)"
            : "0 2px 8px rgba(15, 23, 42, 0.08)",
          transition: "border-color 150ms ease, box-shadow 150ms ease",
        }}
      >
        <div
          style={{
            position: "relative",
            overflow: "hidden",
            borderRadius: "8px",
            background: "#e2e8f0",
          }}
        >
          <TemplateThumbnail template={template} />

          {isActive && (
            <span
              style={{
                position: "absolute",
                top: "8px",
                right: "8px",
                padding: "4px 8px",
                borderRadius: "999px",
                background: "#2563eb",
                color: "#ffffff",
                fontSize: "0.75rem",
                fontWeight: 700,
              }}
            >
              Active
            </span>
          )}
        </div>

        <span
          style={{
            display: "block",
            marginTop: "10px",
            fontSize: "1rem",
            fontWeight: 700,
          }}
        >
          {template.name}
        </span>

        <span
          style={{
            display: "block",
            marginTop: "4px",
            color: "#64748b",
            fontSize: "0.875rem",
            lineHeight: 1.4,
          }}
        >
          {template.description}
        </span>
      </button>
    </li>
  );
};

const ActiveSvgCanvas = () => {
  const {
    currentTemplate,
    selectedLayerId,
    setSelectedLayerId,
    updateCurrentLayer,
  } = useContext(MainContext);

  const svgRef = useRef(null);
  const dragRef = useRef(null);

  const gradientPrefix = `editor-${currentTemplate.id}`;

  const handleLayerDragStart = (event, layer) => {
    const svgElement = svgRef.current;

    if (!svgElement || layer.locked) {
      return;
    }

    event.currentTarget.setPointerCapture(event.pointerId);

    dragRef.current = {
      pointerId: event.pointerId,
      layer,
      startPoint: getSvgPoint(svgElement, event.clientX, event.clientY),
    };
  };

  const handlePointerMove = (event) => {
    const svgElement = svgRef.current;
    const drag = dragRef.current;

    if (!svgElement || !drag) {
      return;
    }

    const point = getSvgPoint(svgElement, event.clientX, event.clientY);

    const deltaX = point.x - drag.startPoint.x;
    const deltaY = point.y - drag.startPoint.y;

    updateCurrentLayer(drag.layer.id, moveLayer(drag.layer, deltaX, deltaY));
  };

  const stopDragging = (event) => {
    if (
      dragRef.current &&
      event.currentTarget.hasPointerCapture(event.pointerId)
    ) {
      event.currentTarget.releasePointerCapture(event.pointerId);
    }

    dragRef.current = null;
  };

  return (
    <svg
      ref={svgRef}
      viewBox={`0 0 ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
      width="100%"
      role="img"
      aria-label={`${currentTemplate.name} editable SVG canvas`}
      onPointerDown={(event) => {
        if (event.target === event.currentTarget) {
          setSelectedLayerId(null);
        }
      }}
      onPointerMove={handlePointerMove}
      onPointerUp={stopDragging}
      onPointerCancel={stopDragging}
      style={{
        display: "block",
        width: "100%",
        aspectRatio: "3 / 2",
        borderRadius: "12px",
        background: "#ffffff",
        overflow: "hidden",
        touchAction: "none",
        boxShadow: "0 12px 35px rgba(15, 23, 42, 0.2)",
      }}
    >
      <SvgDefs prefix={gradientPrefix} />

      {currentTemplate.Layers.map((layer) => (
        <SvgLayer
          key={layer.id}
          layer={layer}
          gradientPrefix={gradientPrefix}
          editable
          isSelected={selectedLayerId === layer.id}
          onSelect={setSelectedLayerId}
          onDragStart={handleLayerDragStart}
        />
      ))}
    </svg>
  );
};

